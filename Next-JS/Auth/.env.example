# Use a new database; this example does not migrate existing users.
MONGO_URI=mongodb://127.0.0.1:27017/learning_auth
# Generate with: openssl rand -hex 32
JWT_SECRET=
# Exact browser origin, also used in email links. Set to the HTTPS preview URL in Arena.
APP_URL=http://localhost:3000
# Local Mailpit defaults; configure your SMTP provider for real delivery.
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Auth Lab <auth@example.test>
